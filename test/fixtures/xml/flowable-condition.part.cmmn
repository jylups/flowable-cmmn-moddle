<cmmn:extensionElements xmlns:cmmn="http://www.omg.org/spec/CMMN/20151109/MODEL" xmlns:flowable="http://flowable.org/cmmn">
  <flowable:condition group="true" match="all" targetAttribute="condition">
    <flowable:condition sourceVariableType="variable" sourceName="decided" sourceType="number" sourceScope="self" operator="vars:exists" />
    <flowable:condition sourceVariableType="variable" sourceName="decided" sourceType="number" operator="equals" targetVariableType="value" targetValue="2" targetType="number" />
  </flowable:condition>
</cmmn:extensionElements>
