<cmmn:definitions xmlns:cmmn="http://www.omg.org/spec/CMMN/20151109/MODEL" xmlns:cmmndi="http://www.omg.org/spec/CMMN/20151109/CMMNDI" xmlns:dc="http://www.omg.org/spec/CMMN/20151109/DC" xmlns:flowable="http://flowable.org/cmmn" id="Definitions_1" targetNamespace="http://flowable.org/cmmn">
  <cmmn:case id="Case_1" name="Order" flowable:initiatorVariableName="initiator" flowable:candidateStarterUsers="kermit,fozzie" flowable:candidateStarterGroups="sales" flowable:async="true">
    <cmmn:casePlanModel id="CasePlanModel_1" name="Plan" flowable:formKey="orderForm" flowable:formFieldValidation="false" flowable:sameDeployment="false">
      <cmmn:planItem id="PlanItem_1" definitionRef="Task_1" />
      <cmmn:task id="Task_1" name="Check" />
    </cmmn:casePlanModel>
  </cmmn:case>
  <cmmndi:CMMNDI>
