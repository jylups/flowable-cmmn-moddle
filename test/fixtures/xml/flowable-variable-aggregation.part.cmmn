<cmmn:extensionElements xmlns:cmmn="http://www.omg.org/spec/CMMN/20151109/MODEL" xmlns:flowable="http://flowable.org/cmmn">
  <flowable:variableAggregation target="reviews" createOverviewVariable="true">
    <cmmn:variable source="approved" />
    <cmmn:variable sourceExpression="${comment}" target="description" />
  </flowable:variableAggregation>
  <flowable:variableAggregation targetExpression="${target}" delegateExpression="${aggregator}" storeAsTransientVariable="true" />
</cmmn:extensionElements>
